---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    
    <div class="text-5xl font-bold">I'm Zachary Landry</div>

    <div class="text-3xl py-3 font-bold">
      Electrical Engineering and Physics Student at Northeastern University
    </div>

    <div class="py-2">
      <text class="text-lg">
        I’m interested in embedded systems, robotics, analog electronics, and computational tools. I enjoy taking projects from concept through design, fabrication, programming, and testing, using each one as an opportunity to solve new engineering problems and expand my technical skills.
      </text>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">My Projects</div>
  </div>

  <HorizontalCard
    title="Hexapod Robot"
    img="/HexBod.png"
    desc="Custom designed hexapod robot with wireless controls. Can walk around, wave, and dance with stable movement. The 3D designed and printed body and legs are paired with a custom designed PCB which connects the servo drivers, microcontroller, and battery charging circuitry."
    url="/projects/hexapod"
  />

  <div class="divider my-0"></div>

  <HorizontalCard
    title="Differential Equation Visualizer"
    img="/2.png"
    desc="Find the graphical solution to any first or second order ordinary differential equation. Initial values and window parameters can be set. First order solutions are graphed with their slope field. Special functions like sine, unit step, and impulse are available."
    url="/projects/diffeq"
  />

  <div class="divider my-0"></div>

  <HorizontalCard
    title="Analog Synthesizer"
    img="/synthpic.webp"
    desc="Analog synthesizer with no IC's (aside from op-amps and OTA's) in the signal chain. Complete with manual and voltage controlled signals, custom PCB, battery charging circuitry, and 3D printed housing. Hear your music and see what wave its composed of on the LCD screen with custom code."
    url="/projects/synth"
    badge="Work in Progress"
  />

  <div class="divider my-0"></div>

  <HorizontalCard
    title="Analog RF Reciever"
    img="/rfpic.jpg"
    desc="Switch between AM and FM bands to listen in on radio channels. Additionally, capture a moment of the demodulated signal to see its frequency spectrum through Fourier analysis."
    url="/projects/rf-receiver"
    badge="Work in Progress"
  />

</BaseLayout>