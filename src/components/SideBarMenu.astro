---
const { sideBarActiveItemID } = Astro.props;
const activeClass = "bg-base-300"; // For primary color replace with `active` class
---

<ul class="menu grow shrink menu-md overflow-y-auto">
    <li><a class="py-3 text-base" id="home" href="/">Home</a></li>
    <li class="group">
        <button class="py-3 text-base w-full text-left flex justify-between items-center">
            Projects
            <span class="transition-transform group-hover:rotate-90">›</span>
        </button>

        <ul class="ml-4 mt-1 hidden group-hover:block">
            <li><a href="/projects/hexapod" class="py-2 block">Hexapod Robot</a></li>
            <li><a href="/projects/diffeq" class="py-2 block">Differential Equation Visualizer</a></li>
            <li><a href="/projects/photo" class="py-2 block">Digital Photo Frame</a></li>
            <li><a href="/projects/synth" class="py-2 block">Analog Synthesizer</a></li>
            <li><a href="/projects/rf-receiver" class="py-2 block">Analog RF Receiver</a></li>
        </ul>
    </li>

    <li><a class="py-3 text-base" id="cv" href="/cv">Resume</a></li>
</ul>

<script define:vars={{ sideBarActiveItemID: sideBarActiveItemID, activeClass: activeClass }}>
const activeItemElem = document.getElementById(sideBarActiveItemID);
activeItemElem && activeItemElem.classList.add(activeClass);
</script>
